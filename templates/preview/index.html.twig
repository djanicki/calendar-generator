{% extends 'base.html.twig' %}

{% block title %}Calendar Preview - {{ grid.monthName }} {{ grid.year }}{% endblock %}

{% block body %}
    <div class="preview-container">
        <div class="calendar-paper">
            <div class="calendar-header">
                <h2>{{ grid.monthName }}</h2>
                <div class="calendar-year">{{ grid.year }}</div>
            </div>

            <div class="calendar-grid" style="--week-count: {{ grid.weeks|length }};">
                {% for header in grid.headers %}
                    <div class="calendar-grid-header">{{ header }}</div>
                {% endfor %}

                {% for week in grid.weeks %}
                    {% for day in week %}
                        <div class="calendar-day-cell {% if not day.isCurrentMonth %}other-month{% endif %}">
                            {{ day.day }}
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        </div>
            <p class="terms-notice">By clicking Generate, you agree to our <a href="/terms" target="_blank">Terms and Conditions</a>.</p>
        <div class="preview-actions">

            <a href="{{ path('app_home', {month: grid.month, year: grid.year, first_day: grid.startDayOfWeek}) }}" class="btn btn-secondary">
                <span class="icon">&larr;</span> Back
            </a>
            <form action="{{ path('app_preview_generate') }}" method="POST">
                <input type="hidden" name="month" value="{{ grid.month }}">
                <input type="hidden" name="year" value="{{ grid.year }}">
                <input type="hidden" name="first_day" value="{{ grid.startDayOfWeek }}">
                <button type="submit" class="btn btn-primary">
                    Generate
                </button>
            </form>
        </div>
    </div>
{% endblock %}
