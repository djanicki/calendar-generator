{% extends 'base.html.twig' %}

{% block title %}{{ 'preview.page_title'|trans }} - {{ ('months.' ~ grid.monthName|lower)|trans }} {{ grid.year }}{% endblock %}

{% block body %}
    <div class="preview-container">
        <div class="calendar-paper template-{{ template }}">
            <div class="calendar-header">
                <h2>{{ ('months.' ~ grid.monthName|lower)|trans }}</h2>
                <div class="calendar-year">{{ grid.year }}</div>
            </div>

            <div class="calendar-grid" style="--week-count: {{ grid.weeks|length }};">
                {% for header in grid.headers %}
                    <div class="calendar-grid-header">{{ ('days.' ~ header|lower)|trans }}</div>
                {% endfor %}

                {% for week in grid.weeks %}
                    {% for day in week %}
                        <div class="calendar-day-cell {% if not day.isCurrentMonth %}other-month{% endif %}">
                            {{ day.day }}
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        </div>
            <p class="terms-notice">{{ 'preview.terms_notice'|trans({'%link_start%': '<a href="/terms" target="_blank">', '%link_end%': '</a>'})|raw }}</p>
        <div class="preview-actions">

            <a href="{{ path('app_home', {month: grid.month, year: grid.year, first_day: grid.startDayOfWeek, template: template}) }}" class="btn btn-secondary">
                <span class="icon">&larr;</span> {{ 'preview.btn_back'|trans }}
            </a>
            <form action="{{ path('app_preview_generate') }}" method="POST">
                <input type="hidden" name="month" value="{{ grid.month }}">
                <input type="hidden" name="year" value="{{ grid.year }}">
                <input type="hidden" name="first_day" value="{{ grid.startDayOfWeek }}">
                <input type="hidden" name="template" value="{{ template }}">
                <button type="submit" class="btn btn-primary">
                    {{ 'preview.btn_generate'|trans }}
                </button>
            </form>
        </div>
    </div>
{% endblock %}
