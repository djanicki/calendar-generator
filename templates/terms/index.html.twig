{% extends 'base.html.twig' %}

{% block title %}{{ 'terms.page_title'|trans }} - {{ 'app.title'|trans }}{% endblock %}

{% block body %}
<div class="terms-page-layout">
    <div class="container terms-container">
        <!-- Sidebar Navigation -->
        <aside class="terms-sidebar">
            <div class="sticky-toc">
                <h3>{{ 'terms.sidebar_title'|trans }}</h3>
                <nav class="toc-nav">
                    <ul>
                        <li><a href="#acceptance" class="toc-link">{{ 'terms.toc.acceptance'|trans }}</a></li>
                        <li><a href="#description" class="toc-link">{{ 'terms.toc.description'|trans }}</a></li>
                        <li><a href="#warranty" class="toc-link">{{ 'terms.toc.warranty'|trans }}</a></li>
                        <li><a href="#liability" class="toc-link">{{ 'terms.toc.liability'|trans }}</a></li>
                        <li><a href="#responsibility" class="toc-link">{{ 'terms.toc.responsibility'|trans }}</a></li>
                        <li><a href="#property" class="toc-link">{{ 'terms.toc.property'|trans }}</a></li>
                        <li><a href="#use" class="toc-link">{{ 'terms.toc.use'|trans }}</a></li>
                        <li><a href="#third-party" class="toc-link">{{ 'terms.toc.third_party'|trans }}</a></li>
                        <li><a href="#privacy" class="toc-link">{{ 'terms.toc.privacy'|trans }}</a></li>
                        <li><a href="#indemnification" class="toc-link">{{ 'terms.toc.indemnification'|trans }}</a></li>
                        <li><a href="#availability" class="toc-link">{{ 'terms.toc.availability'|trans }}</a></li>
                        <li><a href="#advice" class="toc-link">{{ 'terms.toc.advice'|trans }}</a></li>
                        <li><a href="#governing" class="toc-link">{{ 'terms.toc.governing'|trans }}</a></li>
                        <li><a href="#severability" class="toc-link">{{ 'terms.toc.severability'|trans }}</a></li>
                        <li><a href="#agreement" class="toc-link">{{ 'terms.toc.agreement'|trans }}</a></li>
                        <li><a href="#contact" class="toc-link">{{ 'terms.toc.contact'|trans }}</a></li>
                        <li><a href="#summary" class="toc-link summary-toc-link">{{ 'terms.toc.summary'|trans }}</a></li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Terms Content -->
        <article class="terms-content">
            <header class="terms-header">
                <h1>{{ 'terms.page_title'|trans }}</h1>
                <p class="last-updated">{{ 'terms.last_updated'|trans }}</p>
            </header>

            <section id="acceptance" class="terms-section">
                <h2>{{ 'terms.sections.acceptance.title'|trans }}</h2>
                <p>{{ 'terms.sections.acceptance.content'|trans }}</p>
            </section>

            <section id="description" class="terms-section">
                <h2>{{ 'terms.sections.description.title'|trans }}</h2>
                <p>{{ 'terms.sections.description.content'|trans }}</p>
            </section>

            <section id="warranty" class="terms-section">
                <h2>{{ 'terms.sections.warranty.title'|trans }}</h2>
                <div class="disclaimer-text">
                    <p>{{ 'terms.sections.warranty.disclaimer1'|trans }}</p>
                    <p>{{ 'terms.sections.warranty.disclaimer2'|trans }}</p>
                    <ul>
                        <li>{{ 'terms.sections.warranty.list1_item1'|trans }}</li>
                        <li>{{ 'terms.sections.warranty.list1_item2'|trans }}</li>
                        <li>{{ 'terms.sections.warranty.list1_item3'|trans }}</li>
                        <li>{{ 'terms.sections.warranty.list1_item4'|trans }}</li>
                        <li>{{ 'terms.sections.warranty.list1_item5'|trans }}</li>
                    </ul>
                    <p>{{ 'terms.sections.warranty.disclaimer3'|trans }}</p>
                    <ul>
                        <li>{{ 'terms.sections.warranty.list2_item1'|trans }}</li>
                        <li>{{ 'terms.sections.warranty.list2_item2'|trans }}</li>
                        <li>{{ 'terms.sections.warranty.list2_item3'|trans }}</li>
                        <li>{{ 'terms.sections.warranty.list2_item4'|trans }}</li>
                    </ul>
                </div>
                <p>{{ 'terms.sections.warranty.content'|trans }}</p>
            </section>

            <section id="liability" class="terms-section">
                <h2>{{ 'terms.sections.liability.title'|trans }}</h2>
                <div class="disclaimer-text">
                    <p>{{ 'terms.sections.liability.disclaimer1'|trans }}</p>
                    <ul>
                        <li>{{ 'terms.sections.liability.list_item1'|trans }}</li>
                        <li>{{ 'terms.sections.liability.list_item2'|trans }}</li>
                        <li>{{ 'terms.sections.liability.list_item3'|trans }}</li>
                        <li>{{ 'terms.sections.liability.list_item4'|trans }}</li>
                        <li>{{ 'terms.sections.liability.list_item5'|trans }}</li>
                        <li>{{ 'terms.sections.liability.list_item6'|trans }}</li>
                    </ul>
                </div>
                <p>{{ 'terms.sections.liability.content'|trans }}</p>
            </section>

            <section id="responsibility" class="terms-section">
                <h2>{{ 'terms.sections.responsibility.title'|trans }}</h2>
                <p>{{ 'terms.sections.responsibility.content1'|trans }}</p>
                <ul>
                    <li>{{ 'terms.sections.responsibility.list_item1'|trans }}</li>
                    <li>{{ 'terms.sections.responsibility.list_item2'|trans }}</li>
                    <li>{{ 'terms.sections.responsibility.list_item3'|trans }}</li>
                    <li>{{ 'terms.sections.responsibility.list_item4'|trans }}</li>
                </ul>
            </section>

            <section id="property" class="terms-section">
                <h2>{{ 'terms.sections.property.title'|trans }}</h2>
                <p>{{ 'terms.sections.property.content1'|trans }}</p>
                <p>{{ 'terms.sections.property.content2'|trans }}</p>
                <p>{{ 'terms.sections.property.content3'|trans }}</p>
            </section>

            <section id="use" class="terms-section">
                <h2>{{ 'terms.sections.use.title'|trans }}</h2>
                <p>{{ 'terms.sections.use.content1'|trans }}</p>
                <ul>
                    <li>{{ 'terms.sections.use.list_item1'|trans }}</li>
                    <li>{{ 'terms.sections.use.list_item2'|trans }}</li>
                    <li>{{ 'terms.sections.use.list_item3'|trans }}</li>
                    <li>{{ 'terms.sections.use.list_item4'|trans }}</li>
                </ul>
            </section>

            <section id="third-party" class="terms-section">
                <h2>{{ 'terms.sections.third_party.title'|trans }}</h2>
                <p>{{ 'terms.sections.third_party.content1'|trans }}</p>
                <p>{{ 'terms.sections.third_party.content2'|trans }}</p>
            </section>

            <section id="privacy" class="terms-section">
                <h2>{{ 'terms.sections.privacy.title'|trans }}</h2>
                <p>{{ 'terms.sections.privacy.content1'|trans }}</p>
                <p>{{ 'terms.sections.privacy.content2'|trans }}</p>
            </section>

            <section id="indemnification" class="terms-section">
                <h2>{{ 'terms.sections.indemnification.title'|trans }}</h2>
                <p>{{ 'terms.sections.indemnification.content1'|trans }}</p>
                <ul>
                    <li>{{ 'terms.sections.indemnification.list_item1'|trans }}</li>
                    <li>{{ 'terms.sections.indemnification.list_item2'|trans }}</li>
                    <li>{{ 'terms.sections.indemnification.list_item3'|trans }}</li>
                </ul>
            </section>

            <section id="availability" class="terms-section">
                <h2>{{ 'terms.sections.availability.title'|trans }}</h2>
                <p>{{ 'terms.sections.availability.content1'|trans }}</p>
                <ul>
                    <li>{{ 'terms.sections.availability.list_item1'|trans }}</li>
                    <li>{{ 'terms.sections.availability.list_item2'|trans }}</li>
                    <li>{{ 'terms.sections.availability.list_item3'|trans }}</li>
                </ul>
            </section>

            <section id="advice" class="terms-section">
                <h2>{{ 'terms.sections.advice.title'|trans }}</h2>
                <p>{{ 'terms.sections.advice.content1'|trans }}</p>
                <p>{{ 'terms.sections.advice.content2'|trans }}</p>
            </section>

            <section id="governing" class="terms-section">
                <h2>{{ 'terms.sections.governing.title'|trans }}</h2>
                <p>{{ 'terms.sections.governing.content1'|trans }}</p>
            </section>

            <section id="severability" class="terms-section">
                <h2>{{ 'terms.sections.severability.title'|trans }}</h2>
                <p>{{ 'terms.sections.severability.content1'|trans }}</p>
            </section>

            <section id="agreement" class="terms-section">
                <h2>{{ 'terms.sections.agreement.title'|trans }}</h2>
                <p>{{ 'terms.sections.agreement.content1'|trans }}</p>
            </section>

            <section id="contact" class="terms-section">
                <h2>{{ 'terms.sections.contact.title'|trans }}</h2>
                <p>{{ 'terms.sections.contact.content1'|trans }}</p>
            </section>

            <hr class="terms-divider">

            <section id="summary" class="terms-summary-card">
                <h3>{{ 'terms.sections.summary.title'|trans }}</h3>
                <p>{{ 'terms.sections.summary.content'|trans }}</p>
            </section>
        </article>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const sections = document.querySelectorAll('.terms-section, .terms-summary-card');
        const navLinks = document.querySelectorAll('.toc-link');

        function activateNav() {
            let index = sections.length;

            while(--index && window.scrollY + 100 < sections[index].offsetTop) {}
            
            navLinks.forEach((link) => link.classList.remove('active'));
            if (index >= 0 && index < navLinks.length) {
                navLinks[index].classList.add('active');
            }
        }

        activateNav();
        window.addEventListener('scroll', activateNav);
    });
</script>
{% endblock %}
