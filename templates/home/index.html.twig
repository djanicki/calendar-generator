{% extends 'base.html.twig' %}

{% block title %}Calendar Generator - Welcome{% endblock %}

{% block body %}
    <div class="hero">
        <div class="container">
            <h1>Create Beautiful Calendars in Seconds.</h1>
            <p class="subtitle">A modern, minimalistic tool to generate printable calendars effortlessly.</p>
            
            <div class="cta-container">
                <form class="generator-form" action="{{ path('app_preview') }}" method="GET">
                    <div class="form-group">
                        <label for="month">Month</label>
                        <select id="month" name="month" class="form-control">
                            {% set selectedMonth = app.request.query.get('month', "now"|date("n")) %}
                            {% set months = {1: 'January', 2: 'February', 3: 'March', 4: 'April', 5: 'May', 6: 'June', 7: 'July', 8: 'August', 9: 'September', 10: 'October', 11: 'November', 12: 'December'} %}
                            {% for num, name in months %}
                                <option value="{{ num }}" {% if num == selectedMonth %}selected{% endif %}>{{ name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="year">Year</label>
                        <select id="year" name="year" class="form-control">
                            {% set selectedYear = app.request.query.get('year', "now"|date("Y")) %}
                            {% set currentYear = "now"|date("Y") %}
                            {% for year in currentYear..(currentYear + 5) %}
                                <option value="{{ year }}" {% if year == selectedYear %}selected{% endif %}>{{ year }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-group">
                        <label>First day of the week</label>
                        <div class="radio-group">
                            {% set selectedFirstDay = app.request.query.get('first_day', 'monday')|lower %}
                            <label>
                                <input type="radio" name="first_day" value="monday" {% if selectedFirstDay == 'monday' %}checked{% endif %}> Monday
                            </label>
                            <label>
                                <input type="radio" name="first_day" value="sunday" {% if selectedFirstDay == 'sunday' %}checked{% endif %}> Sunday
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Generate</button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
