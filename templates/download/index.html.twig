{% extends 'base.html.twig' %}

{% block title %}{{ 'download.page_title'|trans }} - {{ 'app.title'|trans }}{% endblock %}

{% block body %}
    <div class="download-container">
        <div class="download-card">
            <div class="download-icon">✓</div>
            <h1 class="download-heading">{{ 'download.heading'|trans }}</h1>
            <p class="download-subtext">{{ 'download.subtext'|trans({'%date%': '<strong>' ~ calendar.selMonth ~ '/' ~ calendar.selYear ~ '</strong>'})|raw }}</p>

            <div class="download-actions">
                <a href="{{ path('app_download_file', {token: calendar.token}) }}" class="btn btn-primary btn-download" id="download-button">
                    <span class="download-btn-icon">⬇</span> {{ 'download.button'|trans }}
                </a>
            </div>

            <div class="download-footer">
                <a href="{{ path('app_home') }}" class="btn btn-secondary">{{ 'download.create_another'|trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}
